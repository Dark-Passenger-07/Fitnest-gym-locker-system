    {
      "name": "3. Allotments APIs",
      "item": [
        {
          "name": "GET /api/allotments (Joined Records)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/allotments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "allotments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(Array.isArray(jsonData)).to.be.true;",
                  "});",
                  "if (jsonData.length > 0) {",
                  "    pm.test('Joined record contains all contract fields', function () {",
                  "        var row = jsonData[0];",
                  "        pm.expect(row).to.have.property('id');",
                  "        pm.expect(row).to.have.property('member_id');",
                  "        pm.expect(row).to.have.property('member_name');",
                  "        pm.expect(row).to.have.property('locker_id');",
                  "        pm.expect(row).to.have.property('locker_name');",
                  "        pm.expect(row).to.have.property('floor');",
                  "        pm.expect(row).to.have.property('allotted_at');",
                  "        pm.expect(row).to.have.property('returned_at');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Mandatory Audit Sequence",
      "item": [
        {
          "name": "Step 1: CREATE Locker for Audit Test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Audit-Seq-Locker\",\n  \"floor\": \"Second\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/lockers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lockers"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Step 1: Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('audit_locker_id', jsonData.id);",
                  "console.log('Created locker ID for audit sequence: ' + jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Step 2: UPDATE Same Locker",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Audit-Seq-Locker-Updated\",\n  \"floor\": \"Third\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/lockers/{{audit_locker_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lockers", "{{audit_locker_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Step 2: Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Step 3: GET /api/audit (Verify UPDATE and CREATE Ordering)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "audit"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Step 3: Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var auditLogs = pm.response.json();",
                  "var targetLockerId = Number(pm.environment.get('audit_locker_id'));",
                  "",
                  "pm.test('Audit log is an array with max 10 entries', function () {",
                  "    pm.expect(Array.isArray(auditLogs)).to.be.true;",
                  "    pm.expect(auditLogs.length).to.be.at.most(10);",
                  "});",
                  "",
                  "// Filter audit logs for the target locker to assert sequence order",
                  "var lockerLogs = auditLogs.filter(function (entry) {",
                  "    return entry.locker_id === targetLockerId;",
                  "});",
                  "",
                  "pm.test('Audit trail contains at least 2 entries for test locker', function () {",
                  "    pm.expect(lockerLogs.length).to.be.at.least(2);",
                  "});",
                  "",
                  "pm.test('Mandatory sequence verified: UPDATE appears before CREATE', function () {",
                  "    pm.expect(lockerLogs[0].action).to.eql('UPDATE');",
                  "    pm.expect(lockerLogs[1].action).to.eql('CREATE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Step 4: DELETE Same Locker & Verify Audit Survival",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/lockers/{{audit_locker_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lockers", "{{audit_locker_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Locker deleted successfully (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Step 5: GET /api/audit (Verify DELETE Row Persists)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "audit"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var auditLogs = pm.response.json();",
                  "var targetLockerId = Number(pm.environment.get('audit_locker_id'));",
                  "",
                  "var latestEntry = auditLogs.find(function (entry) {",
                  "    return entry.locker_id === targetLockerId;",
                  "});",
                  "",
                  "pm.test('Audit row for deleted locker survives with DELETE action', function () {",
                  "    pm.expect(latestEntry).to.not.be.undefined;",
                  "    pm.expect(latestEntry.action).to.eql('DELETE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
