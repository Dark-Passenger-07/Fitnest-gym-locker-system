                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Locker 101\",\n  \"floor\": \"Ground\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/lockers",
