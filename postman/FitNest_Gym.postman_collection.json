              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Locker created with default status AVAILABLE', function () {",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.name).to.eql('Locker 101');",
                  "    pm.expect(jsonData.floor).to.eql('Ground');",
                  "    pm.expect(jsonData.status).to.eql('AVAILABLE');",
                  "});",
                  "pm.environment.set('locker_id', jsonData.id);"
                ],
